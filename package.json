{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "install:backend": "composer install",
        "install:frontend": "npm install",
        "reverb:install": "php artisan reverb:install",
        "reverb:start": "php artisan reverb:start",
        "laravel:setup": "php artisan key:generate && php artisan migrate:fresh --seed",
        "serve": "php artisan serve",
        "dev": "vite",
        "build": "vite build",
        "start-project": "npm-run-all install:backend install:frontend reverb:install storage:link laravel:setup",
        "start": "npm-run-all --parallel serve reverb:start dev",
        "prod": "npm-run-all build serve reverb:start"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.23",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-echo": "^2.2.7",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.5.6",
        "pusher-js": "^8.4.0",
        "tailwindcss": "^3.4.19",
        "vite": "^7.0.7",
        "npm-run-all": "^4.1.5"
    },
    "dependencies": {
        "npm-run-all": "^4.1.5",
        "sass": "^1.97.2"
    }
}
